{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UsageBar",
  "version": "0.2.0",
  "identifier": "io.github.plsy1.usagebar",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "UsageBar",
        "width": 900,
        "height": 580,
        "minWidth": 760,
        "minHeight": 500,
        "visible": false,
        "center": true
      },
      {
        "label": "flyout",
        "title": "UsageBar",
        "url": "index.html#flyout",
        "width": 340,
        "height": 320,
        "visible": false,
        "decorations": false,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "shadow": true
      },
      {
        "label": "card",
        "title": "UsageBar",
        "url": "index.html#card",
        "width": 120,
        "height": 40,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "skipTaskbar": true,
        "focus": false
      },
      {
        "label": "guides",
        "title": "UsageBar",
        "url": "index.html#guides",
        "width": 100,
        "height": 100,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": true,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Remaining Claude and Codex usage in the system tray",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
