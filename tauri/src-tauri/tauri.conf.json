{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UsageBar",
  "version": "0.1.0",
  "identifier": "io.github.plsy1.usagebar",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "UsageBar",
        "width": 900,
        "height": 580,
        "minWidth": 760,
        "minHeight": 500,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Remaining Claude and Codex usage in the system tray",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
